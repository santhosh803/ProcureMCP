# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
# Comma-separated. Not required in local dev (defaults to localhost,127.0.0.1).
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# --- Database (Neon PostgreSQL + pgvector) -----------------------------------
# Enable the extension once in the Neon SQL editor: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Redis broker (Upstash — SHARED instance, namespaced via global_keyprefix) --
# Use the exact same Upstash database as the ReturnPilot project. Do not create a new one.
REDIS_URL=rediss://default:PASSWORD@HOST:6379?ssl_cert_reqs=CERT_NONE

# --- Google Vertex AI (embeddings + reasoning) -------------------------------
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
EMBEDDING_MODEL=text-embedding-004

# --- CORS (production only) --------------------------------------------------
CORS_ALLOWED_ORIGINS=

# --- Notification webhook (optional) -----------------------------------------
# Generic incoming-webhook URL for approval notifications. Compatible with Slack
# incoming webhooks, Teams connectors, Zapier catch-hooks, or any endpoint that
# accepts a JSON POST. Leave empty to keep notifications log-only.
NOTIFICATION_WEBHOOK_URL=

# --- Agent checkpointer (optional tuning) ------------------------------------
# Postgres connection-pool size for the LangGraph checkpointer.
AGENT_CHECKPOINT_POOL_SIZE=5

# --- Railway (production platform detection) ---------------------------------
# Set automatically by Railway. Presence forces DEBUG=off and enables
# HSTS/SSL/secure-cookie hardening. Never set manually in local dev.
# RAILWAY_ENVIRONMENT=production

# --- GCP credentials on platforms without a mounted key file -----------------
# Alternative to GOOGLE_APPLICATION_CREDENTIALS: the full service-account JSON
# as a single-line string. Written to a temp file at startup and pointed at.
# GCP_CREDENTIALS_JSON={"type":"service_account", ...}
